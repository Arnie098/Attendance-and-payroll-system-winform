# Direct database mode
ATTENDANCE_DB_CONNECTION="Server=your-hostinger-server;Port=3306;Database=your-database-name;User ID=your-database-user;Password=your-database-password;SslMode=Preferred;"
# Optional local offline database used when the online database is unavailable.
# MySQL example:
# ATTENDANCE_OFFLINE_DB_CONNECTION="Server=127.0.0.1;Port=3306;Database=attendance_payroll_offline;User ID=your-local-mysql-user;Password=your-local-mysql-password;SslMode=None;"
# SQLite example:
ATTENDANCE_OFFLINE_DB_CONNECTION="Data Source=%LocalAppData%\\AttendancePayrollSystem\\attendance-offline.sqlite"
ATTENDANCE_OFFLINE_AUTO_SYNC=true
ATTENDANCE_OFFLINE_SYNC_INTERVAL_SECONDS=15
SCHOOL_DB_CONNECTION="Server=your-school-db-server;Port=3306;Database=your-school-db-name;User ID=your-school-db-user;Password=your-school-db-password;SslMode=Preferred;"
# Optional: set true to make the school database the only employee source and lock local employee management.
ATTENDANCE_SCHOOL_EMPLOYEES_ONLY=true

# Supabase API mode
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_USE_API=false

# App bootstrap
ATTENDANCE_BOOTSTRAP_ADMIN_PASSWORD="ChangeMe#2026!"
ATTENDANCE_ENABLE_DEMO_ACCOUNTS=false
# ATTENDANCE_DEMO_EMPLOYEE_PASSWORD="ChangeMe#2026!"

# Payroll deduction rates (optional, defaults to current Philippine statutory rates)
# ATTENDANCE_SSS_RATE=0.045
# ATTENDANCE_PHILHEALTH_RATE=0.02
# ATTENDANCE_PAGIBIG_RATE=0.02
# ATTENDANCE_PAGIBIG_CAP=100
# Tax brackets format: "floor:baseTax:rate;floor:baseTax:rate;..."
# ATTENDANCE_TAX_BRACKETS="10417:0:0.15;16666:937.50:0.20;33332:4270.70:0.25;83332:16770.70:0.30;333332:91770.70:0.35"
