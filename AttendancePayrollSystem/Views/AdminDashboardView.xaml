<UserControl x:Class="AttendancePayrollSystem.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="DashboardActionTileStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherTileTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="LauncherTileSubTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDECF0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#0B2430">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F4F9A"
                BorderBrush="#2D6CB2"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Attendance Payroll"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               Margin="0,0,8,0" />
                    <TextBlock Text="System"
                               Foreground="#D5E6F7"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#2A7282"
                BorderBrush="#174C5A"
                BorderThickness="0,0,0,1">
            <Grid>
                <UniformGrid Columns="14">
                    <Border Background="#356D80" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#467E90" BorderBrush="#174C5A" BorderThickness="0.5">
                        <Border.OpacityMask>
                            <DrawingBrush Stretch="Fill">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="Black" Geometry="M 0,0 L 1,0 L 0.5,1 Z" />
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.OpacityMask>
                    </Border>
                    <Border Background="#2D6173" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#3D7889" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#4A8796" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#2D6173" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#467E90" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#356D80" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#2D6173" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#467E90" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#3D7889" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#2D6173" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#467E90" BorderBrush="#174C5A" BorderThickness="0.5" />
                    <Border Background="#356D80" BorderBrush="#174C5A" BorderThickness="0.5" />
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#0B3A3E"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="112" />
                    <RowDefinition Height="112" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#18495B"
                        BorderBrush="#0E3039"
                        Click="OpenEmployeeManagementTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountGroup"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="EMPLOYEE FILES" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="WORKFORCE RECORDS AND TOOLS" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#24715E"
                        BorderBrush="#0E3039"
                        Click="OpenLeaveRequestsTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardList"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="LEAVE REVIEW" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="LEAVE REQUEST WORKSPACE" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#29836C"
                        BorderBrush="#0E3039"
                        Click="OpenPayrollTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashRegister"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="PAYROLL" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="OPEN PAYROLL PROCESSING" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#2A907E"
                        BorderBrush="#0E3039"
                        Click="BirthdayBoardTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CakeVariant"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="BIRTHDAY BOARD" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="{Binding BirthdaySummaryText}" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="4"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#4C9A8C"
                        BorderBrush="#0E3039"
                        Click="LatestRecordsTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardTextClock"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="ATTENDANCE LOGS" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="{Binding LatestAttendances.Count, StringFormat={}{0} RECENT LOGS}" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#0E3644"
                        BorderBrush="#0E3039">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="78"
                                Height="78"
                                Background="#0A2733"
                                BorderBrush="#557E96"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="8">
                            <Grid>
                                <Grid x:Name="DashboardBrandLogoFallbackPanel">
                                    <materialDesign:PackIcon Kind="ShieldAccount"
                                                             Width="38"
                                                             Height="38"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Grid>
                                <Image x:Name="DashboardBrandLogoImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="ATTENDANCE PAYROLL SYSTEM"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DashboardDateText}"
                                       Foreground="#C8DDE8"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Logo"
                                        Width="72"
                                        Height="28"
                                        Style="{StaticResource ModernButton}"
                                        Margin="0,0,6,0"
                                        Click="UpdateBrandLogoButton_Click" />
                                <Button x:Name="ClearBrandLogoButton"
                                        Content="Clear"
                                        Width="72"
                                        Height="28"
                                        Style="{StaticResource ModernButton}"
                                        Background="#A85B10"
                                        Click="ClearBrandLogoButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#113E42"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TODAY'S BOARD"
                                   Foreground="#BDE7E1"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DashboardDateText}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Light"
                                   Margin="0,8,0,6" />
                        <TextBlock Text="Launcher console for daily attendance, payroll, leave, and workforce operations."
                                   Foreground="#D8EFF0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="1" Grid.Column="4"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#2E8C78"
                        BorderBrush="#0E3039"
                        Click="RefreshButton_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="REFRESH" Style="{StaticResource LauncherTileTextStyle}" />
                        <TextBlock Text="RELOAD RUNTIME DATA" Style="{StaticResource LauncherTileSubTextStyle}" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="1" Grid.Column="5"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#246E65"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DatabaseStatusBadgeText}"
                                   Foreground="#D7FFF7"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DatabaseStatusTitle}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,6,0,6"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DatabaseStatusDetail}"
                                   Foreground="#ECFDFB"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="1" Grid.Column="6"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#71B4A8"
                        BorderBrush="#0E3039"
                        Click="BackupDatabaseButton_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseExport"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="#12323A"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="BACKUP"
                                   Foreground="#12323A"
                                   FontSize="12"
                                   FontWeight="Bold" />
                        <TextBlock Text="CREATE SQL EXPORT"
                                   Foreground="#20424A"
                                   FontSize="10" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#71412C"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL EMPLOYEES"
                                   Foreground="#FFE8D9"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalEmployees}"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="ACTIVE RECORDS"
                                   Foreground="#FFEFE4"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#C87700"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRESENT TODAY"
                                   Foreground="#FFF0C5"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PresentToday}"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="RECORDED TIME-IN"
                                   Foreground="#FFF7E1"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#E0B103"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LATE TODAY"
                                   Foreground="#FFF7CB"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LateToday}"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="LATE STATUS"
                                   Foreground="#FFFCE6"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="3"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#A76016"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ABSENT TODAY"
                                   Foreground="#FFE3C1"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AbsentToday}"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="NO PRESENCE LOG"
                                   Foreground="#FFF2E2"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="4"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#123E4B"
                        BorderBrush="#0E3039">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Width="72"
                                Height="72"
                                Background="#0A2733"
                                BorderBrush="#557E96"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="8">
                            <Grid>
                                <Grid x:Name="DashboardBrandLogoPreviewFallbackPanel">
                                    <TextBlock Text="APS"
                                               Foreground="White"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Image x:Name="DashboardBrandLogoPreviewImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="SYSTEM BRAND"
                                   Foreground="#D8ECF2"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="5"
                        Style="{StaticResource DashboardPanelStyle}"
                        Background="#365364"
                        BorderBrush="#0E3039">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MODULES READY"
                                   Foreground="#E2EEF4"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="7"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="ADMIN LAUNCHERS"
                                   Foreground="#F0F7FB"
                                   FontSize="10" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="2" Grid.Column="6"
                        Style="{StaticResource DashboardActionTileStyle}"
                        Background="#D26E0A"
                        BorderBrush="#0E3039"
                        Click="LogoutTile_Click">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="LogoutVariant"
                                                 Width="44"
                                                 Height="44"
                                                 Foreground="White"
                                                 Margin="0,0,0,10" />
                        <TextBlock Text="EXIT"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold" />
                        <TextBlock Text="RETURN TO LOGIN"
                                   Foreground="#FFF1E0"
                                   FontSize="10" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="#E7EBEF"
                BorderBrush="#BFC8CF"
                BorderThickness="0,1,0,0"
                Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#BFC8CF"
                        BorderThickness="0,0,1,0">
                    <TextBlock Text="Dashboard"
                               Foreground="#334155"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
