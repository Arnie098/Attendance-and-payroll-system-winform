<Window x:Class="AttendancePayrollSystem.PayrollModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Payroll Processing"
        Height="800"
        Width="1080"
        MinHeight="600"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    CornerRadius="18"
                    Padding="22,20"
                    Margin="0,0,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B1220" Offset="0" />
                        <GradientStop Color="#14532D" Offset="0.55" />
                        <GradientStop Color="#155E75" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="#0F172A" />
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Width="56"
                            Height="56"
                            Background="#1FFFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="CashMultiple"
                                                 Width="30"
                                                 Height="30"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Payroll Processing"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                     Width="15"
                                                     Height="15"
                                                     Foreground="#B7D7E2"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="{Binding EmployeeDisplay}"
                                       Foreground="#D8F3F0"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Calculate Section -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="20">
                <StackPanel>
                    <!-- Pay Period -->
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="CalendarRange"
                                                 Width="20" Height="20"
                                                 Foreground="#0F766E"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Pay Period"
                                   Style="{StaticResource SectionTitle}"
                                   FontWeight="Bold"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Start Date" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <DatePicker x:Name="PayPeriodStartPicker" SelectedDate="{Binding PeriodStart}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="End Date" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <DatePicker x:Name="PayPeriodEndPicker" SelectedDate="{Binding PeriodEnd}" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                Padding="12,10"
                                VerticalAlignment="Bottom">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="18" Height="18"
                                                         Foreground="#1D4ED8"
                                                         VerticalAlignment="Top"
                                                         Margin="0,1,8,0" />
                                <TextBlock Text="Leave SSS, PhilHealth, Pag-IBIG, or tax blank to auto-calculate from the current payroll settings."
                                           Foreground="#334155"
                                           FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14" />

                    <!-- Deductions -->
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="CashMinus"
                                                 Width="20" Height="20"
                                                 Foreground="#9A3412"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Deductions"
                                   Style="{StaticResource SectionTitle}"
                                   FontWeight="Bold"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                            <TextBlock Text="SSS" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="SssDeductionTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:TextFieldAssist.PrefixText="₱"
                                     materialDesign:HintAssist.Hint="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                            <TextBlock Text="PhilHealth" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="PhilHealthDeductionTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:TextFieldAssist.PrefixText="₱"
                                     materialDesign:HintAssist.Hint="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                            <TextBlock Text="Pag-IBIG" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="PagIbigDeductionTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:TextFieldAssist.PrefixText="₱"
                                     materialDesign:HintAssist.Hint="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Text="Tax" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="WithholdingTaxTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:TextFieldAssist.PrefixText="₱"
                                     materialDesign:HintAssist.Hint="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Manual Deduction" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="ManualDeductionAmountTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:TextFieldAssist.PrefixText="₱"
                                     materialDesign:HintAssist.Hint="0.00"
                                     Text="0.00" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,0">
                            <TextBlock Text="Deduction Note" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBox x:Name="ManualDeductionNoteTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     materialDesign:HintAssist.Hint="Reason (optional)"
                                     MaxLength="255" />
                        </StackPanel>

                        <Button Grid.Row="1" Grid.Column="3"
                                Height="44"
                                Style="{StaticResource ModernButton}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"
                                Click="CalculatePayroll_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Calculator"
                                                         Width="18" Height="18"
                                                         Foreground="White"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="Calculate Payroll"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Statutory Deduction Rates Reference -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="CalculatorVariant"
                                                 Width="20" Height="20"
                                                 Foreground="#1E3A8A"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Statutory Deduction Rates"
                                   Style="{StaticResource SectionTitle}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SSS" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13" />
                                <TextBlock Text="4.5% of gross" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PhilHealth" FontWeight="Bold" Foreground="#166534" FontSize="13" />
                                <TextBlock Text="2% of gross" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF7ED" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pag-IBIG" FontWeight="Bold" Foreground="#9A3412" FontSize="13" />
                                <TextBlock Text="2% (cap ₱100)" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#F5F3FF" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Tax" FontWeight="Bold" Foreground="#5B21B6" FontSize="13" />
                                <TextBlock Text="BIR brackets" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Payroll Records DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Payroll Records" Style="{StaticResource SectionTitle}" FontWeight="Bold" />

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,6"
                            Margin="0,8,0,4">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="Magnify"
                                                     Width="20" Height="20"
                                                     Foreground="#94A3B8"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,8,0" />
                            <TextBox x:Name="PayrollSearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     TextChanged="PayrollSearchBox_TextChanged" />
                            <TextBlock Text="Search by period, status, or amount..."
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PayrollSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="PayrollDataGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding Payrolls}"
                              Style="{StaticResource ModernDataGrid}"
                              MouseDoubleClick="PayrollDataGrid_MouseDoubleClick"
                              SelectionChanged="PayrollDataGrid_SelectionChanged"
                              Margin="0,8,0,0"
                              MinHeight="160"
                              MaxHeight="300"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Period Start" Binding="{Binding PayPeriodStart, StringFormat=yyyy-MM-dd}" Width="95" />
                            <DataGridTextColumn Header="Period End" Binding="{Binding PayPeriodEnd, StringFormat=yyyy-MM-dd}" Width="95" />
                            <DataGridTextColumn Header="Reg Hrs" Binding="{Binding RegularHours, StringFormat=N2}" Width="65" />
                            <DataGridTextColumn Header="OT Hrs" Binding="{Binding OvertimeHours, StringFormat=N2}" Width="60" />
                            <DataGridTextColumn Header="Gross" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="90" />
                            <DataGridTextColumn Header="Late" Binding="{Binding TotalTardinessMinutes, StringFormat={}{0} min}" Width="60" />
                            <DataGridTextColumn Header="Late Ded" Binding="{Binding TardinessDeduction, StringFormat=₱{0:N2}}" Width="80" />
                            <DataGridTextColumn Header="Manual" Binding="{Binding ManualDeduction, StringFormat=₱{0:N2}}" Width="75" />
                            <DataGridTextColumn Header="Deductions" Binding="{Binding Deductions, StringFormat=₱{0:N2}}" Width="90" />
                            <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, StringFormat=₱{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="90"
                                                ElementStyle="{StaticResource PayrollStatusTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="16">
                    <materialDesign:PackIcon Kind="CursorDefaultClickOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Double-click a payroll record above to edit or delete it."
                               Foreground="#64748B"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Width="110"
                        Style="{StaticResource ModernButton}"
                        Background="#475569"
                        Click="Close_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="17" Height="17"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Close" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
