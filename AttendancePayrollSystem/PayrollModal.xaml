<Window x:Class="AttendancePayrollSystem.PayrollModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Payroll Processing"
        Height="800"
        Width="1080"
        MinHeight="600"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#123C47"
                    BorderBrush="#2D7082"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Payroll Processing"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding EmployeeDisplay}"
                                   Foreground="#B7D7E2"
                                   FontSize="14"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Calculate Section -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Pay Period Start" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <DatePicker x:Name="PayPeriodStartPicker" SelectedDate="{Binding PeriodStart}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Pay Period End" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <DatePicker x:Name="PayPeriodEndPicker" SelectedDate="{Binding PeriodEnd}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Manual Deduction (₱)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ManualDeductionAmountTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="0.00" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,0">
                        <TextBlock Text="Deduction Note" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ManualDeductionNoteTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 MaxLength="255" />
                    </StackPanel>

                    <Button Grid.Row="1" Grid.Column="3"
                            Content="Calculate Payroll"
                            Width="160"
                            Height="38"
                            Style="{StaticResource ModernButton}"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="CalculatePayroll_Click" />
                </Grid>
            </Border>

            <!-- Statutory Deduction Rates Reference -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="CalculatorVariant"
                                                 Width="20" Height="20"
                                                 Foreground="#1E3A8A"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Statutory Deduction Rates"
                                   Style="{StaticResource SectionTitle}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SSS" FontWeight="Bold" Foreground="#1E3A8A" FontSize="13" />
                                <TextBlock Text="4.5% of gross" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PhilHealth" FontWeight="Bold" Foreground="#166534" FontSize="13" />
                                <TextBlock Text="2% of gross" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF7ED" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pag-IBIG" FontWeight="Bold" Foreground="#9A3412" FontSize="13" />
                                <TextBlock Text="2% (cap ₱100)" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#F5F3FF" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Tax" FontWeight="Bold" Foreground="#5B21B6" FontSize="13" />
                                <TextBlock Text="BIR brackets" Foreground="#334155" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Payroll Records DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Payroll Records" Style="{StaticResource SectionTitle}" FontWeight="Bold" />

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,6"
                            Margin="0,8,0,4">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="Magnify"
                                                     Width="20" Height="20"
                                                     Foreground="#94A3B8"
                                                     VerticalAlignment="Center"
                                                     Margin="4,0,8,0" />
                            <TextBox x:Name="PayrollSearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     TextChanged="PayrollSearchBox_TextChanged" />
                            <TextBlock Text="Search by period, status, or amount..."
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PayrollSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="PayrollDataGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding Payrolls}"
                              Style="{StaticResource ModernDataGrid}"
                              MouseDoubleClick="PayrollDataGrid_MouseDoubleClick"
                              SelectionChanged="PayrollDataGrid_SelectionChanged"
                              Margin="0,8,0,0"
                              MinHeight="160"
                              MaxHeight="300"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Period Start" Binding="{Binding PayPeriodStart, StringFormat=yyyy-MM-dd}" Width="95" />
                            <DataGridTextColumn Header="Period End" Binding="{Binding PayPeriodEnd, StringFormat=yyyy-MM-dd}" Width="95" />
                            <DataGridTextColumn Header="Reg Hrs" Binding="{Binding RegularHours, StringFormat=N2}" Width="65" />
                            <DataGridTextColumn Header="OT Hrs" Binding="{Binding OvertimeHours, StringFormat=N2}" Width="60" />
                            <DataGridTextColumn Header="Gross" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="90" />
                            <DataGridTextColumn Header="Late" Binding="{Binding TotalTardinessMinutes, StringFormat={}{0} min}" Width="60" />
                            <DataGridTextColumn Header="Late Ded" Binding="{Binding TardinessDeduction, StringFormat=₱{0:N2}}" Width="80" />
                            <DataGridTextColumn Header="Manual" Binding="{Binding ManualDeduction, StringFormat=₱{0:N2}}" Width="75" />
                            <DataGridTextColumn Header="Deductions" Binding="{Binding Deductions, StringFormat=₱{0:N2}}" Width="90" />
                            <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, StringFormat=₱{0:N2}}" Width="95" />
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="6,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Processed">
                                                            <Setter Property="Background" Value="#DBEAFE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                            <Setter Property="Background" Value="#D1FAE5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#92400E" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Processed">
                                                                <Setter Property="Foreground" Value="#1E40AF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                                <Setter Property="Foreground" Value="#065F46" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="#991B1B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="16">
                    <materialDesign:PackIcon Kind="CursorDefaultClickOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Double-click a payroll record above to edit or delete it."
                               Foreground="#64748B"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Close" Width="100" Style="{StaticResource ModernButton}" Background="#475569" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
