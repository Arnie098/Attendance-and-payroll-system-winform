<Window x:Class="AttendancePayrollSystem.EmployeeSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Find Employee"
        Height="620"
        Width="920"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Search Employee" Style="{StaticResource HeaderText}" />
            <TextBlock Text="Find the employee first, then open the management details for that record."
                       Foreground="#64748B"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,4"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <materialDesign:PackIcon Kind="Magnify"
                                         Width="20"
                                         Height="20"
                                         Foreground="#94A3B8"
                                         DockPanel.Dock="Left"
                                         VerticalAlignment="Center"
                                         Margin="4,0,8,0" />
                <Button x:Name="ClearSearchButton"
                        DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        ToolTip="Clear search"
                        Visibility="Collapsed"
                        Click="ClearSearch_Click">
                    <materialDesign:PackIcon Kind="Close"
                                             Width="18"
                                             Height="18"
                                             Foreground="#64748B"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Button>
                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             MinHeight="34"
                             Padding="0,7,0,5"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown" />
                    <TextBlock Text="Search by name, code, position, department, email, phone, or status..."
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <DataGrid x:Name="EmployeeDataGrid"
                  Grid.Row="2"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MouseDoubleClick="EmployeeDataGrid_MouseDoubleClick"
                  SelectionChanged="EmployeeDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="110" />
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="220" />
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="150" />
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchResultCountTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#64748B" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SelectButton"
                        Content="Select Employee"
                        Width="140"
                        Margin="0,0,8,0"
                        Style="{StaticResource ModernButton}"
                        Click="Select_Click" />
                <Button Content="Cancel"
                        Width="100"
                        Style="{StaticResource ModernButton}"
                        Background="#64748B"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
