<Window x:Class="AttendancePayrollSystem.PayrollEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Payroll Record"
        Height="620"
        Width="760"
        MinHeight="520"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Edit Payroll Record" Style="{StaticResource HeaderText}" />
            <TextBlock x:Name="EmployeeTextBlock"
                       Foreground="#64748B"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Period Start" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <DatePicker x:Name="ManualPeriodStartPicker" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Period End" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <DatePicker x:Name="ManualPeriodEndPicker" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,10">
                    <TextBlock Text="Regular Hours" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualRegularHoursTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                    <TextBlock Text="OT Hours" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualOvertimeHoursTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Gross Pay" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualGrossPayTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Deductions" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualDeductionsTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,10">
                    <TextBlock Text="Net Pay" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualNetPayTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                    <TextBlock Text="Status" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ManualStatusComboBox">
                        <ComboBoxItem Content="Pending" />
                        <ComboBoxItem Content="Processed" />
                        <ComboBoxItem Content="Paid" />
                        <ComboBoxItem Content="Cancelled" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Manual Deduction" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualManualDeductionTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                    <TextBlock Text="Manual Deduction Note" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBox x:Name="ManualManualDeductionNoteTextBox" Style="{StaticResource ModernTextBox}" MaxLength="255" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save"
                    Width="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Click="Save_Click" />
            <Button Content="Delete"
                    Width="100"
                    Margin="0,0,8,0"
                    Background="#DC2626"
                    Style="{StaticResource ModernButton}"
                    Click="Delete_Click" />
            <Button Content="Cancel"
                    Width="100"
                    Background="#64748B"
                    Style="{StaticResource ModernButton}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
