<Window x:Class="AttendancePayrollSystem.LatestAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Latest Attendance Records"
        Height="820"
        Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                CornerRadius="18"
                Padding="22,20"
                Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#14532D" Offset="0.55" />
                    <GradientStop Color="#155E75" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="#0F172A" />
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="56"
                        Height="56"
                        Background="#1FFFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="CalendarClock"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Latest Attendance Records"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Recent employee time entries from the attendance database."
                               Foreground="#D8F3F0"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Summary badges -->
                    <Border Background="#064E3B"
                            CornerRadius="999"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="14" Height="14" Foreground="#6EE7B7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="PresentCountText"
                                       Text="0 Present"
                                       Foreground="#6EE7B7"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#7C2D12"
                            CornerRadius="999"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockAlert" Width="14" Height="14" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="LateCountText"
                                       Text="0 Late"
                                       Foreground="#FCA5A5"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0A2534"
                            CornerRadius="999"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="#D4FBF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="TotalCountText"
                                       Text="0 records"
                                       Foreground="#D4FBF8"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <!-- Search Box -->
                <Border DockPanel.Dock="Left"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,6"
                        Width="320">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Width="20" Height="20"
                                                 Foreground="#94A3B8"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,8,0" />
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="Search by name, code, or status..."
                                   Foreground="#94A3B8"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Status Filter -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Status:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="StatusFilterCombo"
                              Width="130"
                              FontSize="13"
                              SelectionChanged="StatusFilter_Changed">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Present" />
                        <ComboBoxItem Content="Late" />
                        <ComboBoxItem Content="On Leave" />
                        <ComboBoxItem Content="Absent" />
                    </ComboBox>
                </StackPanel>

                <!-- Date Filter -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Date:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker x:Name="DateFilterPicker"
                                Width="140"
                                FontSize="13"
                                SelectedDateChanged="DateFilter_Changed" />
                    <Button Width="30" Height="30"
                            Padding="0"
                            Margin="4,0,0,0"
                            ToolTip="Clear date filter"
                            Click="ClearDateFilter_Click"
                            Style="{StaticResource ModernButton}"
                            Background="#64748B">
                        <materialDesign:PackIcon Kind="CalendarRemove"
                                                 Width="16" Height="16"
                                                 Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- Right-side record count -->
                <TextBlock DockPanel.Dock="Right"
                           x:Name="FilteredCountText"
                           Text="Showing all records"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2"
                Style="{StaticResource ModernCard}"
                Margin="0">
            <DataGrid x:Name="AttendanceGrid"
                      ItemsSource="{Binding LatestAttendances}"
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      RowHeight="40"
                      ColumnHeaderHeight="42"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="#EEF2F7"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="Foreground" Value="#334155" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="80" />
                    <DataGridTextColumn Header="Employee Name" Binding="{Binding FullName}" Width="160" />
                    <DataGridTextColumn Header="Date" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="95" />
                    <DataGridTextColumn Header="In AM" Binding="{Binding TimeIn, StringFormat=HH:mm}" Width="60" />
                    <DataGridTextColumn Header="Out AM" Binding="{Binding TimeOutAM, StringFormat=HH:mm}" Width="65" />
                    <DataGridTextColumn Header="In PM" Binding="{Binding TimeInPM, StringFormat=HH:mm}" Width="60" />
                    <DataGridTextColumn Header="Out PM" Binding="{Binding TimeOut, StringFormat=HH:mm}" Width="65" />
                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}" Width="75" />
                    <DataGridTextColumn Header="Late (min)" Binding="{Binding TardinessMinutes}" Width="90" />
                    <DataGridTemplateColumn Header="Status" Width="140" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AttendanceStatusPillStyle}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               Style="{StaticResource AttendanceStatusTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="LastRefreshedText"
                       Text="Last refreshed: —"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="120"
                        Style="{StaticResource ModernButton}"
                        Background="#0F766E"
                        Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDelimitedOutline"
                                                 Width="17" Height="17"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Export CSV" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="110"
                        Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="17" Height="17"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Width="110"
                        Style="{StaticResource ModernButton}"
                        Background="#475569"
                        Click="Close_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="17" Height="17"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Close" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
