<Window x:Class="AttendancePayrollSystem.LatestAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Latest Attendance Records"
        Height="760"
        Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#123C47"
                BorderBrush="#2D7082"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Latest Attendance Records"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Recent employee time entries from the attendance database."
                               Foreground="#B7D7E2"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#0A2534"
                        CornerRadius="999"
                        Padding="12,6"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding LatestAttendances.Count, StringFormat={}{0} recent logs}"
                               Foreground="#D4FBF8"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Margin="0">
            <DataGrid ItemsSource="{Binding LatestAttendances}"
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="100" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="180" />
                    <DataGridTextColumn Header="Date" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="100" />
                    <DataGridTextColumn Header="In AM" Binding="{Binding TimeIn, StringFormat=HH:mm}" Width="70" />
                    <DataGridTextColumn Header="Out PM" Binding="{Binding TimeOut, StringFormat=HH:mm}" Width="70" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Refresh"
                    Width="110"
                    Style="{StaticResource ModernButton}"
                    Click="Refresh_Click" />
            <Button Content="Close"
                    Width="110"
                    Style="{StaticResource ModernButton}"
                    Background="#475569"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
