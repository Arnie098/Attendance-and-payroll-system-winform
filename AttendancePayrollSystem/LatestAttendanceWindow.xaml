<Window x:Class="AttendancePayrollSystem.LatestAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Latest Attendance Records"
        Height="820"
        Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="#123C47"
                BorderBrush="#2D7082"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Latest Attendance Records"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Recent employee time entries from the attendance database."
                               Foreground="#B7D7E2"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Summary badges -->
                    <Border Background="#064E3B"
                            CornerRadius="999"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="14" Height="14" Foreground="#6EE7B7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="PresentCountText"
                                       Text="0 Present"
                                       Foreground="#6EE7B7"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#7C2D12"
                            CornerRadius="999"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockAlert" Width="14" Height="14" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="LateCountText"
                                       Text="0 Late"
                                       Foreground="#FCA5A5"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0A2534"
                            CornerRadius="999"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="#D4FBF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="TotalCountText"
                                       Text="0 records"
                                       Foreground="#D4FBF8"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <!-- Search Box -->
                <Border DockPanel.Dock="Left"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,6"
                        Width="320">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Width="20" Height="20"
                                                 Foreground="#94A3B8"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,8,0" />
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="Search by name, code, or status..."
                                   Foreground="#94A3B8"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Status Filter -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Status:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="StatusFilterCombo"
                              Width="130"
                              FontSize="13"
                              SelectionChanged="StatusFilter_Changed">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Present" />
                        <ComboBoxItem Content="Late" />
                        <ComboBoxItem Content="On Leave" />
                        <ComboBoxItem Content="Absent" />
                    </ComboBox>
                </StackPanel>

                <!-- Date Filter -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Date:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker x:Name="DateFilterPicker"
                                Width="140"
                                FontSize="13"
                                SelectedDateChanged="DateFilter_Changed" />
                    <Button Content="✕"
                            Width="28" Height="28"
                            FontSize="12"
                            Padding="0"
                            Margin="4,0,0,0"
                            ToolTip="Clear date filter"
                            Click="ClearDateFilter_Click"
                            Style="{StaticResource ModernButton}"
                            Background="#64748B" />
                </StackPanel>

                <!-- Right-side record count -->
                <TextBlock DockPanel.Dock="Right"
                           x:Name="FilteredCountText"
                           Text="Showing all records"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2"
                Style="{StaticResource ModernCard}"
                Margin="0">
            <DataGrid x:Name="AttendanceGrid"
                      ItemsSource="{Binding LatestAttendances}"
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="80" />
                    <DataGridTextColumn Header="Employee Name" Binding="{Binding FullName}" Width="160" />
                    <DataGridTextColumn Header="Date" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="95" />
                    <DataGridTextColumn Header="In AM" Binding="{Binding TimeIn, StringFormat=HH:mm}" Width="60" />
                    <DataGridTextColumn Header="Out AM" Binding="{Binding TimeOutAM, StringFormat=HH:mm}" Width="65" />
                    <DataGridTextColumn Header="In PM" Binding="{Binding TimeInPM, StringFormat=HH:mm}" Width="60" />
                    <DataGridTextColumn Header="Out PM" Binding="{Binding TimeOut, StringFormat=HH:mm}" Width="65" />
                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}" Width="75" />
                    <DataGridTextColumn Header="Late (min)" Binding="{Binding TardinessMinutes}" Width="90" />
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Present">
                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Late">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="On Leave">
                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Present">
                                                        <Setter Property="Foreground" Value="#065F46" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Late">
                                                        <Setter Property="Foreground" Value="#991B1B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="On Leave">
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                        <Setter Property="Foreground" Value="#92400E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="LastRefreshedText"
                       Text="Last refreshed: —"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Export CSV"
                        Width="110"
                        Style="{StaticResource ModernButton}"
                        Background="#0F766E"
                        Click="ExportCsv_Click" />
                <Button Content="Refresh"
                        Width="110"
                        Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="8,0,0,0" />
                <Button Content="Close"
                        Width="110"
                        Style="{StaticResource ModernButton}"
                        Background="#475569"
                        Click="Close_Click"
                        Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
