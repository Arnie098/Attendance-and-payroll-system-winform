<Window x:Class="AttendancePayrollSystem.LeaveRequestModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Leave Request"
        Height="720"
        Width="560"
        WindowStartupLocation="CenterOwner"
        MinHeight="450" MinWidth="420"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="File Leave Request" Style="{StaticResource HeaderText}" />
            <TextBlock Text="Submit a leave schedule for admin approval. Chargeable days count weekdays only."
                       Foreground="#64748B"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Background="#EFF6FF"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Employee"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="EmployeeNameTextBlock"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="EmployeeCodeTextBlock"
                               Foreground="#475569"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Leave Type" />
                <ComboBox x:Name="LeaveTypeComboBox"
                          SelectionChanged="LeaveTypeComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Payment Rule" />
                <TextBox x:Name="PaymentTypeTextBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Start Date" />
                <DatePicker x:Name="StartDatePicker"
                            SelectedDateChanged="LeaveDatePicker_SelectedDateChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="End Date" />
                <DatePicker x:Name="EndDatePicker"
                            SelectedDateChanged="LeaveDatePicker_SelectedDateChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Style="{StaticResource ModernCard}"
                Background="#F8FAFC"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Chargeable Weekdays" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ChargeableDaysTextBlock"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Attendance Status on Approval" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AttendanceStatusTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="Reason" Margin="0,0,0,6" />
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <TextBox x:Name="ReasonTextBox"
                         MinHeight="140"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         VerticalContentAlignment="Top" />
            </Border>
        </StackPanel>

        <!-- Supporting Documents (multi-file) -->
        <StackPanel Grid.Row="6" Margin="0,0,0,12">
            <TextBlock Text="Supporting Documents (optional)" Margin="0,0,0,6" />
            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <StackPanel>
                    <ListBox x:Name="DocumentsListBox"
                             MinHeight="40"
                             MaxHeight="130"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,0,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📄 " VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeLabel}"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Width="22" Height="22"
                                            Padding="0"
                                            FontSize="10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#DC2626"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="RemoveDocument_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="+ Add Files"
                            HorizontalAlignment="Left"
                            Height="28"
                            Padding="12,0"
                            Style="{StaticResource ModernButton}"
                            Background="#0F766E"
                            Click="AddDocuments_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Submit"
                    Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Background="#0F766E"
                    Click="Submit_Click" />
            <Button Content="Cancel"
                    Width="100"
                    Style="{StaticResource ModernButton}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
