<Window x:Class="AttendancePayrollSystem.LeaveRequestModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Leave Request"
        Height="660"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="File Leave Request" Style="{StaticResource HeaderText}" />
            <TextBlock Text="Submit a leave schedule for admin approval. Chargeable days count weekdays only."
                       Foreground="#64748B"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Background="#EFF6FF"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Employee"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="EmployeeNameTextBlock"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="EmployeeCodeTextBlock"
                               Foreground="#475569"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Leave Type" />
                <ComboBox x:Name="LeaveTypeComboBox"
                          SelectionChanged="LeaveTypeComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Payment Rule" />
                <TextBox x:Name="PaymentTypeTextBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Start Date" />
                <DatePicker x:Name="StartDatePicker"
                            SelectedDateChanged="LeaveDatePicker_SelectedDateChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="End Date" />
                <DatePicker x:Name="EndDatePicker"
                            SelectedDateChanged="LeaveDatePicker_SelectedDateChanged" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Style="{StaticResource ModernCard}"
                Background="#F8FAFC"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Chargeable Weekdays" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ChargeableDaysTextBlock"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Attendance Status on Approval" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AttendanceStatusTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="Reason" />
            <TextBox x:Name="ReasonTextBox"
                     Style="{StaticResource ModernTextBox}"
                     Height="220"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Submit"
                    Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    Background="#0F766E"
                    Click="Submit_Click" />
            <Button Content="Cancel"
                    Width="100"
                    Style="{StaticResource ModernButton}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
