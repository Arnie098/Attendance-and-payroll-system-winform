<Window x:Class="AttendancePayrollSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sign in - Attendance Payroll System"
        Height="760"
        MinHeight="720"
        Width="980"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <Border Style="{StaticResource ModernCard}" Padding="0" CornerRadius="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="430" />
                        <ColumnDefinition Width="0.95*" MinWidth="400" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="24,0,0,24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1220" Offset="0" />
                                <GradientStop Color="#14532D" Offset="0.58" />
                                <GradientStop Color="#155E75" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid Margin="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="76"
                                        Height="76"
                                        HorizontalAlignment="Left"
                                        Background="#1FFFFFFF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="9">
                                    <Grid>
                                        <Grid x:Name="BrandLogoFallbackPanel">
                                            <materialDesign:PackIcon Kind="ShieldAccountVariant"
                                                                     Width="42"
                                                                     Height="42"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Grid>
                                        <Image x:Name="BrandLogoImage"
                                               Stretch="Uniform"
                                               Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="Attendance Payroll System"
                                           Margin="0,28,0,0"
                                           Foreground="White"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           LineHeight="39"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Fast, role-aware access for administrators and employees, with database settings available when the connection needs attention."
                                           Margin="0,14,0,0"
                                           Foreground="#D8F3F0"
                                           FontSize="15"
                                           LineHeight="22"
                                           TextWrapping="Wrap" />

                                <Border Margin="0,22,0,0"
                                        Padding="14"
                                        Background="#18FFFFFF"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        MaxWidth="280"
                                        HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="Institution"
                                                   Foreground="#BBF7D0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <Border Width="170"
                                                Height="70"
                                                Margin="0,10,0,0"
                                                Padding="8"
                                                Background="#F8FAFC"
                                                CornerRadius="12"
                                                HorizontalAlignment="Left">
                                            <Image Source="pack://application:,,,/Assets/Logos/Techtugon%20logo.jpg"
                                                   Stretch="Uniform" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,32,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="16"
                                        Background="#18FFFFFF"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <materialDesign:PackIcon Kind="AccountTie"
                                                                     Width="21"
                                                                     Height="21"
                                                                     Foreground="#BBF7D0"
                                                                     Margin="0,1,10,0" />
                                            <TextBlock Text="One sign-in"
                                                       Foreground="White"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="Admin and employee users continue through the same secure entry point."
                                                   Margin="0,8,0,0"
                                                   Foreground="#D8F3F0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="16"
                                        Background="#18FFFFFF"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <materialDesign:PackIcon Kind="DatabaseCheckOutline"
                                                                     Width="21"
                                                                     Height="21"
                                                                     Foreground="#A5F3FC"
                                                                     Margin="0,1,10,0" />
                                            <TextBlock Text="Live target"
                                                       Foreground="White"
                                                       FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="Connection mode stays easy to switch before credentials are submitted."
                                                   Margin="0,8,0,0"
                                                   Foreground="#D8F3F0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="3" Visibility="Collapsed">
                                <TextBlock x:Name="DatabaseTargetTextBlock" />
                                <TextBlock x:Name="DatabaseStatusTextBlock" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="0,24,24,0">
                        <Grid Margin="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Welcome heading -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                                <TextBlock Text="Welcome back"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource HeaderBrush}" />
                                <TextBlock Text="Sign in with your assigned admin or employee account."
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource SubHeaderBrush}"
                                           FontSize="14"
                                           LineHeight="20"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Credential fields -->
                            <StackPanel Grid.Row="1">
                                <DockPanel Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="AccountOutline"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="#64748B"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Username"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource HeaderBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox x:Name="UsernameTextBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="46"
                                         Margin="0,0,0,18"
                                         TabIndex="0"
                                         TextChanged="CredentialInput_Changed"
                                         KeyDown="UsernameTextBox_KeyDown"
                                         materialDesign:HintAssist.Hint="Username" />

                                <DockPanel Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="LockOutline"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="#64748B"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Password"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource HeaderBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- Password row: overlays PasswordBox + plain TextBox for show/hide -->
                                <Grid Margin="0,0,0,4">
                                    <PasswordBox x:Name="PasswordBox"
                                                 Style="{StaticResource ModernPasswordBox}"
                                                 Height="46"
                                                 Margin="0"
                                                 Padding="12,0,46,0"
                                                 TabIndex="1"
                                                 PasswordChanged="CredentialInput_Changed"
                                                 KeyDown="PasswordBox_KeyDown"
                                                 materialDesign:HintAssist.Hint="Password" />
                                    <TextBox x:Name="PasswordTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="46"
                                             Margin="0"
                                             Padding="12,0,46,0"
                                             Visibility="Collapsed"
                                             TabIndex="1"
                                             TextChanged="CredentialInput_Changed"
                                             KeyDown="PasswordTextBox_KeyDown"
                                             materialDesign:HintAssist.Hint="Password" />
                                    <ToggleButton x:Name="ShowPasswordToggle"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Width="32"
                                                  Height="32"
                                                  Padding="0"
                                                  Style="{StaticResource MaterialDesignIconToggleButton}"
                                                  Click="ShowPasswordToggle_Click"
                                                  ToolTip="Show / hide password">
                                        <materialDesign:PackIcon x:Name="ShowPasswordIcon"
                                                                 Kind="EyeOutline"
                                                                 Width="18"
                                                                 Height="18" />
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>

                            <!-- Error / status message -->
                            <Border Grid.Row="2"
                                    x:Name="StatusBorder"
                                    Margin="0,4,0,12"
                                    Padding="12"
                                    Background="#FEF2F2"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                             Width="18"
                                                             Height="18"
                                                             Foreground="#B91C1C"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock x:Name="StatusTextBlock"
                                               Foreground="#B91C1C"
                                               FontWeight="SemiBold"
                                               LineHeight="19"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Database mode toggle -->
                            <Border Grid.Row="3"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="DatabaseModeToggle"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Checked="DatabaseModeToggle_Changed"
                                                  Unchecked="DatabaseModeToggle_Changed" />
                                    <materialDesign:PackIcon Kind="DatabaseSyncOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="#1E3A8A"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DatabaseModeLabel"
                                                   Text="Online Database"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#1E293B" />
                                        <TextBlock x:Name="DatabaseModeDescription"
                                                   Text="Using Hostinger MySQL (remote)"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,2,12,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Row 4: spacer -->

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="5">
                                <Button x:Name="LoginButton"
                                        Height="46"
                                        Style="{StaticResource ModernButton}"
                                        Margin="0,0,0,10"
                                        TabIndex="2"
                                        Click="LoginButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="LoginVariant"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="White"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock x:Name="LoginButtonText"
                                                   Text="Sign In"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="DatabaseSettingsButton"
                                        Height="40"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        Margin="0"
                                        TabIndex="3"
                                        Click="DatabaseSettingsButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TuneVariant"
                                                                 Width="16"
                                                                 Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock x:Name="DatabaseSettingsButtonText"
                                                   Text="Database Settings"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border x:Name="BusyOverlay"
                Background="#A60F172A"
                CornerRadius="24"
                Visibility="Collapsed"
                Panel.ZIndex="20">
            <Grid>
                <Border Width="320"
                        Padding="24"
                        Background="#F8FBFF"
                        BorderBrush="#D7E1EF"
                        BorderThickness="1"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Please wait"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource HeaderBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="BusyStatusTextBlock"
                                   Margin="0,10,0,0"
                                   Text="Preparing the application..."
                                   Foreground="{StaticResource SubHeaderBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <ProgressBar Margin="0,18,0,0"
                                     Height="6"
                                     IsIndeterminate="True"
                                     Foreground="#1D4ED8"
                                     Background="#DBEAFE" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
