<Window x:Class="AttendancePayrollSystem.LoginNotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Recent Notifications"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        MaxWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Style="{StaticResource ModernCard}" Padding="0" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#123E4B"
                    CornerRadius="22,22,0,0"
                    Padding="22,18">
                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="BellBadgeOutline"
                                             Width="28"
                                             Height="28"
                                             Foreground="White"
                                             Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Headline}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}"
                                   Margin="0,6,0,0"
                                   Foreground="#D7EEF2"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22">
                    <Border Padding="16"
                            Background="#F8FAFC"
                            BorderBrush="#D7E1EF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Birthdays And Celebrants Today"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource HeaderBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="No birthday-related notifications today."
                                       Foreground="{StaticResource SubHeaderBrush}"
                                       Visibility="{Binding Birthdays.Count, Converter={StaticResource ZeroToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Birthdays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,10,0,0"
                                                Padding="12"
                                                Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="CakeVariant"
                                                                         Width="20"
                                                                         Height="20"
                                                                         Foreground="#C77D12"
                                                                         Margin="0,2,10,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding EmployeeName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource HeaderBrush}" />
                                                    <TextBlock Text="{Binding Label}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{StaticResource SubHeaderBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            Background="#F8FAFC"
                            BorderBrush="#D7E1EF"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock Text="Recent Attendance Activity"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource HeaderBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="No recent attendance activity to review."
                                       Foreground="{StaticResource SubHeaderBrush}"
                                       Visibility="{Binding RecentAttendances.Count, Converter={StaticResource ZeroToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding RecentAttendances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,10,0,0"
                                                Padding="12"
                                                Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="ClipboardTextClockOutline"
                                                                         Width="20"
                                                                         Height="20"
                                                                         Foreground="#1D4ED8"
                                                                         Margin="0,2,10,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding EmployeeName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource HeaderBrush}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{StaticResource SubHeaderBrush}">
                                                        <Run Text="{Binding AttendanceDate, StringFormat={}{0:MMM dd, yyyy}}" />
                                                        <Run Text=" | " />
                                                        <Run Text="{Binding Status}" />
                                                        <Run Text=" | " />
                                                        <Run Text="{Binding TimeIn, StringFormat={}{0:hh:mm tt}, TargetNullValue=No time-in yet}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Background="White"
                    CornerRadius="0,0,22,22"
                    Padding="18">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Review these items before continuing."
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubHeaderBrush}" />
                    <Button Content="Continue"
                            Width="110"
                            Height="40"
                            Style="{StaticResource ModernButton}"
                            Margin="16,0,0,0"
                            Click="Continue_Click" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
