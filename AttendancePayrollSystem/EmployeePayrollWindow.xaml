<Window x:Class="AttendancePayrollSystem.EmployeePayrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="My Payroll Records"
        Height="820"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#123C47"
                BorderBrush="#2D7082"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="My Payroll Records"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock x:Name="EmployeeSubtitleText"
                               Foreground="#B7D7E2"
                               FontSize="14"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="#064E3B" CornerRadius="999" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="14" Height="14" Foreground="#6EE7B7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="TotalNetPayText" Text="Net Total: ₱0.00" Foreground="#6EE7B7" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0A2534" CornerRadius="999" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="#D4FBF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="RecordCountText" Text="0 records" Foreground="#D4FBF8" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="12,10"
                Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,6"
                        Width="280">
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock Text="Search by period or status..."
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Status:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="StatusFilterCombo" Width="120" FontSize="13" SelectionChanged="StatusFilter_Changed">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Pending" />
                        <ComboBoxItem Content="Processed" />
                        <ComboBoxItem Content="Paid" />
                        <ComboBoxItem Content="Cancelled" />
                    </ComboBox>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           x:Name="FilteredCountText"
                           Text="Showing all records"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Payroll DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0">
            <DataGrid x:Name="PayrollGrid"
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      SelectionChanged="PayrollGrid_SelectionChanged"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Period Start" Binding="{Binding PayPeriodStart, StringFormat=yyyy-MM-dd}" Width="100" />
                    <DataGridTextColumn Header="Period End" Binding="{Binding PayPeriodEnd, StringFormat=yyyy-MM-dd}" Width="100" />
                    <DataGridTextColumn Header="Reg Hrs" Binding="{Binding RegularHours, StringFormat=N2}" Width="95" />
                    <DataGridTextColumn Header="OT Hrs" Binding="{Binding OvertimeHours, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Gross Pay" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="110" />
                    <DataGridTextColumn Header="Total Mins of Late" Binding="{Binding TotalTardinessMinutes, StringFormat={}{0} min}" Width="145" />
                    <DataGridTextColumn Header="Late Ded" Binding="{Binding TardinessDeduction, StringFormat=₱{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="Absent" Binding="{Binding AbsentDays, StringFormat={}{0} d}" Width="85" />
                    <DataGridTextColumn Header="Absent Ded" Binding="{Binding AbsenceDeduction, StringFormat=₱{0:N2}}" Width="115" />
                    <DataGridTextColumn Header="Manual Ded" Binding="{Binding ManualDeduction, StringFormat=₱{0:N2}}" Width="115" />
                    <DataGridTextColumn Header="Deductions" Binding="{Binding Deductions, StringFormat=₱{0:N2}}" Width="110" />
                    <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, StringFormat=₱{0:N2}}" Width="100" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="95"
                                        ElementStyle="{StaticResource PayrollStatusTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Payslip Detail Panel (shown when a row is selected) -->
        <Border Grid.Row="3"
                x:Name="PayslipPanel"
                Style="{StaticResource ModernCard}"
                Margin="0,12,0,0"
                Padding="20"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PAY PERIOD" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailPeriod" FontSize="14" FontWeight="Bold" Foreground="#1E293B" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Status: " FontSize="12" Foreground="#64748B" />
                        <TextBlock x:Name="DetailStatus" FontSize="12" Style="{StaticResource PayrollStatusTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="EARNINGS" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailRegular" FontSize="13" Foreground="#1E293B" />
                    <TextBlock x:Name="DetailOvertime" FontSize="13" Foreground="#1E293B" Margin="0,2,0,0" />
                    <TextBlock x:Name="DetailGross" FontSize="14" FontWeight="Bold" Foreground="#065F46" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="DEDUCTIONS" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailLate" FontSize="13" Foreground="#1E293B" />
                    <TextBlock x:Name="DetailAbsent" FontSize="13" Foreground="#1E293B" Margin="0,2,0,0" />
                    <TextBlock x:Name="DetailManual" FontSize="13" Foreground="#1E293B" Margin="0,2,0,0" />
                    <TextBlock x:Name="DetailTotalDed" FontSize="14" FontWeight="Bold" Foreground="#991B1B" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                    <TextBlock Text="NET PAY" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailNetPay" FontSize="22" FontWeight="Bold" Foreground="#0F766E" />
                    <TextBlock x:Name="DetailManualNote" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="200" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="HintText"
                       Text="Click a row to see payslip details."
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export CSV"
                        Style="{StaticResource ModernButton}"
                        Background="#0F766E"
                        Click="ExportCsv_Click" />
                <Button Content="Print Payslip"
                        Style="{StaticResource ModernButton}"
                        Background="#123C47"
                        Click="PrintPayslip_Click"
                        Margin="8,0,0,0" />
                <Button Content="Save as PDF"
                        Style="{StaticResource ModernButton}"
                        Background="#7C2D12"
                        Click="SavePdf_Click"
                        Margin="8,0,0,0" />
                <Button Content="Refresh"
                        Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="8,0,0,0" />
                <Button Content="Close"
                        Style="{StaticResource ModernButton}"
                        Background="#475569"
                        Click="Close_Click"
                        Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
