<Window x:Class="AttendancePayrollSystem.AttendanceModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Biometric Attendance"
        Height="760" Width="980"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1.95*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="{Binding HeaderText}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EmployeeNameText}" FontSize="14" Foreground="#4E5968" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Biometric Scanner" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Border Grid.Row="1" Background="#0B172A" CornerRadius="10" Padding="16" MinHeight="170">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <materialDesign:PackIcon Kind="Fingerprint" Width="92" Height="92" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="1"
                                     Height="6"
                                     Margin="4,8,4,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding ScanStateText}" FontWeight="SemiBold" Margin="0,10,0,2" />
                <TextBlock Grid.Row="3" Text="{Binding LastScanText}" FontSize="12" Foreground="#5C6675" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
            <TabControl>
                <TabItem Header="Today Summary">
                    <StackPanel Margin="8">
                        <TextBlock Text="Attendance Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <TextBlock Text="Morning Session (8:30 AM - 12:00 PM)" FontWeight="SemiBold" FontSize="14" Foreground="#2B6CB0" Margin="0,0,0,6" />

                        <TextBlock Text="Time In (AM)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TimeInAMText}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,4,0,10" />

                        <TextBlock Text="Time Out (AM)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TimeOutAMText}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,4,0,10" />

                        <TextBlock Text="Afternoon Session (1:00 PM - 4:30 PM)" FontWeight="SemiBold" FontSize="14" Foreground="#2B6CB0" Margin="0,8,0,6" />

                        <TextBlock Text="Time In (PM)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TimeInPMText}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,4,0,10" />

                        <TextBlock Text="Time Out (PM)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TimeOutPMText}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,4,0,10" />

                        <TextBlock Text="Next Action" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NextActionText}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,4,0,10" />

                        <Border Background="#EEF2F8" CornerRadius="8" Padding="10">
                            <TextBlock Text="{Binding StatusText}" Foreground="#2D3748" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="AttendanceCrudTab" Header="Attendance Records">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Refresh" Style="{StaticResource ModernButton}" Width="100" Click="RefreshAttendanceCrud_Click" />
                            <Button Content="Clear" Style="{StaticResource ModernButton}" Width="100" Margin="8,0,0,0" Click="ClearAttendanceCrud_Click" />
                        </StackPanel>

                        <DataGrid x:Name="AttendanceCrudDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding AttendanceRecords}"
                                  Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="AttendanceCrudDataGrid_SelectionChanged"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="In AM" Binding="{Binding TimeInAM, StringFormat=HH:mm}" Width="70" />
                                <DataGridTextColumn Header="Out AM" Binding="{Binding TimeOutAM, StringFormat=HH:mm}" Width="70" />
                                <DataGridTextColumn Header="In PM" Binding="{Binding TimeInPM, StringFormat=HH:mm}" Width="70" />
                                <DataGridTextColumn Header="Out PM" Binding="{Binding TimeOutPM, StringFormat=HH:mm}" Width="70" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                <DataGridCheckBoxColumn Header="Bio" Binding="{Binding IsBiometricVerified}" Width="50" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}" Width="60" />
                                <DataGridTextColumn Header="Late (min)" Binding="{Binding TardinessMinutes}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedAttendance}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Date" Style="{StaticResource SectionTitle}" />
                                    <DatePicker x:Name="CrudDatePicker" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="In AM (HH:mm)" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="CrudTimeInAMTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="Out AM (HH:mm)" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="CrudTimeOutAMTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,6,0">
                                    <TextBlock Text="In PM (HH:mm)" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="CrudTimeInPMTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,6,0">
                                    <TextBlock Text="Out PM (HH:mm)" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="CrudTimeOutPMTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <CheckBox x:Name="CrudBiometricVerifiedCheckBox"
                                          Grid.Row="0"
                                          Grid.Column="5"
                                          Content="Biometric"
                                          VerticalAlignment="Bottom"
                                          Margin="4,0,0,4" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,6,0">
                                    <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
                                    <ComboBox x:Name="CrudStatusComboBox">
                                        <ComboBoxItem Content="Present" />
                                        <ComboBoxItem Content="Late" />
                                        <ComboBoxItem Content="Absent" />
                                        <ComboBoxItem Content="On Leave" />
                                        <ComboBoxItem Content="Leave Without Pay" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0">
                                    <Button Content="Update" Width="90" Style="{StaticResource ModernButton}" Click="UpdateAttendanceCrud_Click" />
                                    <Button Content="Delete" Width="90" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Click="DeleteAttendanceCrud_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#EEF2F8" CornerRadius="8" Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedAttendance}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Select an attendance record to edit or delete it."
                                       Foreground="#4E5968"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Simulate Fingerprint"
                    Width="170"
                    Margin="0,0,8,0"
                    Style="{StaticResource ModernButton}"
                    IsEnabled="{Binding IsScanButtonEnabled}"
                    Click="BiometricSimulation_Click" />
            <Button Content="Close" Width="100" Style="{StaticResource ModernButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
