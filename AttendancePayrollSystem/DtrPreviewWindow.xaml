<Window x:Class="AttendancePayrollSystem.DtrPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="DTR Preview"
        Height="820"
        Width="900"
        MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FlowDocumentReader x:Name="PreviewReader"
                            Grid.Row="0"
                            ViewingMode="Scroll" />

        <Border Grid.Row="1"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <!-- Employee navigation (only shown when navigating multiple) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="NavPanel" Visibility="Collapsed">
                    <Button Style="{StaticResource ModernButton}"
                            Background="#334155"
                            Width="36" Height="32"
                            Margin="0,0,4,0"
                            Click="PrevEmployee_Click">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="White" />
                    </Button>
                    <TextBlock x:Name="NavLabel"
                               VerticalAlignment="Center"
                               Margin="4,0"
                               FontWeight="SemiBold"
                               Foreground="#334155" />
                    <Button Style="{StaticResource ModernButton}"
                            Background="#334155"
                            Width="36" Height="32"
                            Margin="4,0,0,0"
                            Click="NextEmployee_Click">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Foreground="White" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Print"
                            Width="100"
                            Style="{StaticResource ModernButton}"
                            Background="#123C47"
                            Margin="0,0,8,0"
                            Click="Print_Click" />
                    <Button Content="Close"
                            Width="80"
                            Style="{StaticResource ModernButton}"
                            Background="#475569"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
