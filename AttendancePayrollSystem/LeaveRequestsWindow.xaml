<Window x:Class="AttendancePayrollSystem.LeaveRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leave Requests"
        Height="860"
        Width="1380"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#103B53"
                BorderBrush="#1F5B73"
                BorderThickness="1"
                CornerRadius="22"
                Margin="0,0,0,16"
                Padding="22,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="58"
                            Height="58"
                            Background="#0D2F42"
                            BorderBrush="#2E6A83"
                            BorderThickness="1"
                            CornerRadius="16">
                        <TextBlock Text="LR"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="Leave Requests"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Review employee leave filings and publish approved leave to attendance records."
                                   Foreground="#C6E4EE"
                                   FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Style="{StaticResource ModernButton}"
                            Click="RefreshLeaveRequests_Click" />
                    <Button x:Name="ApproveLeaveRequestButton"
                            Content="Approve"
                            Style="{StaticResource ModernButton}"
                            Background="#0F766E"
                            IsEnabled="False"
                            Click="ApproveLeaveRequest_Click" />
                    <Button x:Name="RejectLeaveRequestButton"
                            Content="Reject"
                            Style="{StaticResource ModernButton}"
                            Background="#B91C1C"
                            IsEnabled="False"
                            Click="RejectLeaveRequest_Click" />
                    <Button Content="Close"
                            Style="{StaticResource ModernButton}"
                            Background="#475569"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Submitted Requests"
                               Style="{StaticResource SectionTitle}"
                               FontWeight="Bold" />

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <DataGrid x:Name="LeaveRequestsDataGrid"
                                  Width="1320"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="LeaveRequestsDataGrid_SelectionChanged"
                                  MinHeight="340"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="90" />
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="170" />
                                <DataGridTextColumn Header="Type" Binding="{Binding LeaveType}" Width="145" />
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaymentLabel}" Width="90" />
                                <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="115" />
                                <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="115" />
                                <DataGridTextColumn Header="Days" Binding="{Binding ChargeableDays}" Width="70" />
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="100"
                                                    ElementStyle="{StaticResource LeaveStatusTextStyle}" />
                                <DataGridTextColumn Header="Submitted" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="145" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="230" />
                                <DataGridCheckBoxColumn Header="Docs" Binding="{Binding HasDocuments, Mode=OneWay}" Width="50" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Review Details" Style="{StaticResource HeaderText}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Employee | Leave Type -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Employee" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Leave Type" Style="{StaticResource SectionTitle}" />

                            <TextBlock x:Name="SelectedLeaveEmployeeTextBlock"
                                       Grid.Row="1" Grid.Column="0"
                                       Margin="0,4,0,12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedLeaveTypeTextBlock"
                                       Grid.Row="1" Grid.Column="2"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap" />

                            <!-- Row 2: Date Range | Status -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date Range" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Status" Style="{StaticResource SectionTitle}" />

                            <TextBlock x:Name="SelectedLeaveDatesTextBlock"
                                       Grid.Row="3" Grid.Column="0"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedLeaveStatusTextBlock"
                                       Grid.Row="3" Grid.Column="2"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource LeaveStatusTextStyle}" />

                            <!-- Row 4: Payment Rule | Chargeable Days -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Rule" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Chargeable Days" Style="{StaticResource SectionTitle}" />

                            <TextBlock x:Name="SelectedLeavePaymentTextBlock"
                                       Grid.Row="5" Grid.Column="0"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedLeaveChargeableDaysTextBlock"
                                       Grid.Row="5" Grid.Column="2"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap" />

                            <!-- Row 6: Reviewed By (full width) -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="Reviewed By" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="SelectedLeaveReviewedByTextBlock"
                                       Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Reason" Style="{StaticResource SectionTitle}" />
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,4,0,12">
                            <TextBlock x:Name="SelectedLeaveReasonTextBlock" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Supporting Documents" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="ReviewDocumentsListBox"
                                 MinHeight="32"
                                 MaxHeight="140"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderThickness="1"
                                 BorderBrush="#E2E8F0"
                                 Background="#F0FDF4"
                                 Margin="0,4,0,4"
                                 Visibility="Collapsed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📄 " VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#166534"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       Foreground="#4D7C0F"
                                                       FontSize="11"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Open"
                                                Height="26"
                                                Padding="10,0"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource ModernButton}"
                                                Background="#16A34A"
                                                Tag="{Binding}"
                                                Click="OpenDocument_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoDocumentsTextBlock"
                                   Text="No documents attached"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,12"
                                   Visibility="Visible" />

                        <TextBlock Text="Review History" Style="{StaticResource SectionTitle}" />
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,4,0,12">
                            <TextBlock x:Name="SelectedLeaveReviewHistoryTextBlock" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Reviewer Notes" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="LeaveReviewNotesTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="140"
                                 IsEnabled="False"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
