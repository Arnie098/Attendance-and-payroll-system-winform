<Window x:Class="AttendancePayrollSystem.BirthdayBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Birthday Board"
        Height="760"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#123C47"
                BorderBrush="#2D7082"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Birthday Board"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Today's employees with birthdays or hire-date milestones."
                               Foreground="#B7D7E2"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#0A2534"
                        CornerRadius="999"
                        Padding="12,6"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding BirthdaySummaryText}"
                               Foreground="#D4FBF8"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Margin="0">
            <Grid>
                <TextBlock Text="No birthdays today."
                           Foreground="#64748B"
                           FontSize="16"
                           Visibility="{Binding BirthdayCelebrants.Count, Converter={StaticResource ZeroToVisibility}}"
                           VerticalAlignment="Top"
                           Margin="0,4,0,0" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BirthdayCelebrants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F2FFFC"
                                        BorderBrush="#A6EADF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,0,12,12"
                                        MinWidth="260">
                                    <DockPanel>
                                        <Ellipse Width="58"
                                                 Height="58"
                                                 DockPanel.Dock="Left"
                                                 Margin="0,0,12,0">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding ProfileImage, Converter={StaticResource ByteToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#083344"
                                                       FontSize="16" />
                                            <TextBlock Text="{Binding EmployeeCode}"
                                                       Foreground="#4B5563"
                                                       FontSize="12"
                                                       Margin="0,2,0,3" />
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="#0F766E"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Refresh"
                    Width="110"
                    Style="{StaticResource ModernButton}"
                    Click="Refresh_Click" />
            <Button Content="Close"
                    Width="110"
                    Style="{StaticResource ModernButton}"
                    Background="#475569"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
