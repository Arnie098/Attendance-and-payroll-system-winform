<Window x:Class="AttendancePayrollSystem.EmployeeDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Dashboard"
        Height="920"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="8,8,8,16"
                Padding="28"
                CornerRadius="26"
                Background="#12344D"
                BorderBrush="#265773"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="64"
                                Height="64"
                                Background="#0E2738"
                                BorderBrush="#3A6F88"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="8">
                            <Grid>
                                <Grid x:Name="EmployeeBrandLogoFallbackPanel">
                                    <TextBlock Text="APS"
                                               Foreground="White"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Image x:Name="EmployeeBrandLogoImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Employee Workspace"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding WelcomeText}"
                                       FontSize="15"
                                       Foreground="#D4E8F1"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="{Binding TodayText}"
                                       FontSize="13"
                                       Foreground="#9FC2D1" />
                        </StackPanel>
                    </StackPanel>

                    <Border Margin="0,20,0,0"
                            Padding="14,12"
                            CornerRadius="16"
                            Background="#184660"
                            BorderBrush="#2A627D"
                            BorderThickness="1"
                            MaxWidth="640"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Review attendance, file leave requests, and keep your payroll and profile details in one place."
                                   Foreground="#E7F2F7"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           ItemHeight="42">
                    <Button Content="Refresh"
                            Width="112"
                            Style="{StaticResource ModernButton}"
                            Click="Refresh_Click" />
                    <Button Content="My Payroll"
                            Width="120"
                            Style="{StaticResource ModernButton}"
                            Background="#0F766E"
                            Click="ViewPayroll_Click" />
                    <Button Content="File Leave"
                            Width="120"
                            Style="{StaticResource ModernButton}"
                            Background="#7C3AED"
                            Click="FileLeave_Click" />
                    <Button Content="{Binding ClockActionButtonText}"
                            Width="138"
                            Style="{StaticResource ModernButton}"
                            Background="#C26A12"
                            IsEnabled="{Binding IsClockActionEnabled}"
                            Click="ClockAction_Click" />
                    <Button Content="Logout"
                            Width="106"
                            Style="{StaticResource ModernButton}"
                            Background="#475569"
                            Click="Logout_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8,0,8,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource ModernCard}"
                    Margin="0,0,14,0"
                    Background="#F8FBFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="126"
                                Height="126"
                                CornerRadius="63"
                                BorderBrush="#BED3F3"
                                BorderThickness="2"
                                Background="#DBEAFE"
                                ClipToBounds="True"
                                Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="No Photo"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#475569"
                                           FontWeight="SemiBold" />
                                <Image Source="{Binding ProfileImage, Converter={StaticResource ByteToImage}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <Button Content="Change Photo"
                                Width="124"
                                Style="{StaticResource ModernButton}"
                                Click="ChangePhoto_Click" />
                        <Button Content="Remove Photo"
                                Width="124"
                                Style="{StaticResource ModernButton}"
                                Background="#64748B"
                                IsEnabled="{Binding HasProfileImage}"
                                Click="RemovePhoto_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="16,2,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="My Profile"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#163B67"
                                   Margin="0,0,0,14" />
                        <Border Margin="0,0,0,10"
                                Padding="12,10"
                                Background="#E8F1FF"
                                BorderBrush="#D2DFF5"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="{Binding EmployeeCodeText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A" />
                        </Border>
                        <TextBlock Text="{Binding PositionText}" FontSize="14" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding DepartmentText}" FontSize="14" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding HourlyRateText}" FontSize="14" Margin="0,4,0,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ModernCard}"
                    Margin="0,0,14,0"
                    Background="#ECFDF5">
                <StackPanel>
                    <TextBlock Text="Today Attendance"
                               Foreground="#166534"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <Border Padding="12,10"
                            Background="#D9FBE7"
                            BorderBrush="#B9E8CD"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding AttendanceStatusText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#14532D" />
                    </Border>
                    <TextBlock Text="{Binding TimeInText, StringFormat='In: {0}'}" Margin="0,2,0,6" FontSize="13" />
                    <TextBlock Text="{Binding TimeOutText, StringFormat='Out: {0}'}" Margin="0,2,0,0" FontSize="13" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource ModernCard}"
                    Margin="0,0,14,0"
                    Background="#FFF7ED">
                <StackPanel>
                    <TextBlock Text="Latest Payroll"
                               Foreground="#9A3412"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding LatestPayrollText}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource ModernCard}"
                    Background="#F5F3FF">
                <StackPanel>
                    <TextBlock Text="Latest Leave Request"
                               Foreground="#6D28D9"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding LatestLeaveText}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

            <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource ModernCard}"
                    Margin="0,0,12,12"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="My Attendance History"
                               Style="{StaticResource SectionTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#243B53" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AttendanceHistory}"
                              Style="{StaticResource ModernDataGrid}"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="110" />
                            <DataGridTextColumn Header="In AM" Binding="{Binding TimeInAM, StringFormat=HH:mm}" Width="74" />
                            <DataGridTextColumn Header="Out AM" Binding="{Binding TimeOutAM, StringFormat=HH:mm}" Width="74" />
                            <DataGridTextColumn Header="In PM" Binding="{Binding TimeInPM, StringFormat=HH:mm}" Width="74" />
                            <DataGridTextColumn Header="Out PM" Binding="{Binding TimeOutPM, StringFormat=HH:mm}" Width="74" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="92" />
                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=N2}" Width="76" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ModernCard}"
                    Margin="0,0,0,12"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="My Payroll Records"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#243B53" />
                        <Button DockPanel.Dock="Right"
                                Content="View All"
                                Width="96"
                                Height="32"
                                Style="{StaticResource ModernButton}"
                                Background="#0F766E"
                                Click="ViewPayroll_Click" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PayrollHistory}"
                              Style="{StaticResource ModernDataGrid}"
                              Margin="0,8,0,0"
                              VerticalAlignment="Stretch"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Period Start" Binding="{Binding PayPeriodStart, StringFormat=yyyy-MM-dd}" Width="108" />
                            <DataGridTextColumn Header="Period End" Binding="{Binding PayPeriodEnd, StringFormat=yyyy-MM-dd}" Width="108" />
                            <DataGridTextColumn Header="Gross" Binding="{Binding GrossPay, StringFormat=PHP {0:N2}}" Width="112" />
                            <DataGridTextColumn Header="Deductions" Binding="{Binding Deductions, StringFormat=PHP {0:N2}}" Width="112" />
                            <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, StringFormat=PHP {0:N2}}" Width="112" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource ModernCard}"
                    Margin="0"
                    Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="My Leave Requests"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#243B53" />
                        <Button DockPanel.Dock="Right"
                                Content="Cancel Selected"
                                Width="138"
                                Style="{StaticResource ModernButton}"
                                Background="#7C3AED"
                                IsEnabled="{Binding CanCancelSelectedLeave}"
                                Click="CancelSelectedLeave_Click" />
                    </DockPanel>

                    <DataGrid x:Name="LeaveRequestsDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding LeaveRequests}"
                              Style="{StaticResource ModernDataGrid}"
                              Margin="0,8,0,0"
                              SelectionChanged="LeaveRequestsDataGrid_SelectionChanged"
                              MinHeight="230"
                              MaxHeight="340"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding LeaveType}" Width="150" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaymentLabel}" Width="90" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="120" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="120" />
                            <DataGridTextColumn Header="Days" Binding="{Binding ChargeableDays}" Width="80" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Reviewed By" Binding="{Binding ReviewedBy}" Width="120" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
