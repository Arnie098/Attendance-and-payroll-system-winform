<Window x:Class="AttendancePayrollSystem.DtrLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="DTR Ledger"
        Height="860"
        Width="1420"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                CornerRadius="18"
                Padding="22,20"
                Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#1E3A5F" Offset="0.55" />
                    <GradientStop Color="#0F4C75" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="#0F172A" />
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="56" Height="56"
                        Background="#1FFFFFFF"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ClipboardTextClock"
                                             Width="30" Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="DTR Ledger"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Daily Time Record — employee attendance with department, punch status, and tardiness."
                               Foreground="#D0E8FF"
                               Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="BadgeRecords" Background="#1E3A5F" CornerRadius="999" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BadgeRecordsText" Text="0 records" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="BadgePresent" Background="#064E3B" CornerRadius="999" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="14" Height="14" Foreground="#6EE7B7" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BadgePresentText" Text="0 Present" Foreground="#6EE7B7" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="BadgeLate" Background="#7C2D12" CornerRadius="999" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockAlert" Width="14" Height="14" Foreground="#FCA5A5" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BadgeLateText" Text="0 Late" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="BadgeLeave" Background="#1E1B4B" CornerRadius="999" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardList" Width="14" Height="14" Foreground="#A5B4FC" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BadgeLeaveText" Text="0 Leave" Foreground="#A5B4FC" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="BadgeMissing" Background="#3B1F0A" CornerRadius="999" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#FCD34D" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BadgeMissingText" Text="0 Missing Punch" Foreground="#FCD34D" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource ModernCard}"
                Padding="14,10"
                Margin="0,0,0,10">
            <DockPanel>
                <!-- Clear button pinned right -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ModernButton}"
                        Background="#64748B"
                        Click="ClearFilters_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Missing punch toggle pinned right of other filters -->
                <CheckBox x:Name="MissingPunchCheck"
                          DockPanel.Dock="Right"
                          Content="Missing punch only"
                          FontSize="13"
                          Foreground="#64748B"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Checked="Filter_Changed"
                          Unchecked="Filter_Changed" />

                <!-- Left-to-right filters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,6" Width="240" Margin="0,0,12,0">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,6,0" />
                            <!-- Grid is the last DockPanel child so it fills remaining width.
                                 TextBox and placeholder both fill the Grid and overlap correctly. -->
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged" />
                                <TextBlock Text="Name or code…" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Department -->
                    <TextBlock Text="Dept:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="DeptFilterCombo" Width="150" FontSize="13" SelectionChanged="Filter_Changed" Margin="0,0,14,0" />

                    <!-- Status -->
                    <TextBlock Text="Status:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="StatusFilterCombo" Width="150" FontSize="13" SelectionChanged="Filter_Changed" Margin="0,0,14,0">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Present" />
                        <ComboBoxItem Content="Late" />
                        <ComboBoxItem Content="On Leave" />
                        <ComboBoxItem Content="Leave Without Pay" />
                        <ComboBoxItem Content="Absent" />
                    </ComboBox>

                    <!-- From Date -->
                    <TextBlock Text="From:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="StartDatePicker" Width="130" FontSize="13" SelectedDateChanged="Filter_Changed" Margin="0,0,14,0" />

                    <!-- To Date -->
                    <TextBlock Text="To:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="EndDatePicker" Width="130" FontSize="13" SelectedDateChanged="Filter_Changed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Totals Row -->
        <Border Grid.Row="2"
                Style="{StaticResource ModernCard}"
                Padding="16,8"
                Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="TotalsText"
                           DockPanel.Dock="Left"
                           Text="Total: 0 hrs  |  Tardiness: 0 min"
                           Foreground="#475569"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="FilteredCountText"
                           DockPanel.Dock="Right"
                           Text="Showing all records"
                           Foreground="#94A3B8"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="3"
                Style="{StaticResource ModernCard}"
                Margin="0">
            <DataGrid x:Name="LedgerGrid"
                      Style="{StaticResource ModernDataGrid}"
                      Margin="0"
                      RowHeight="42"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="#EEF2F7"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Absent">
                                <Setter Property="Background" Value="#FFF1F2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasMissingPunch}" Value="True">
                                <Setter Property="Background" Value="#FFFBEB" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"       Binding="{Binding EmployeeCode}"                            Width="88" />
                    <DataGridTextColumn Header="Full Name"  Binding="{Binding FullName}"                                Width="160" />
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}"                              Width="120" />

                    <!-- Status pill -->
                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AttendanceStatusPillStyle}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               Style="{StaticResource AttendanceStatusTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Date"       Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="102" />

                    <!-- AM In -->
                    <DataGridTemplateColumn Header="AM In" Width="115" SortMemberPath="TimeInAM">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeInAM, StringFormat=hh:mm tt}" FontSize="13" />
                                    <TextBlock Text="{Binding TimeInAMLabel}" FontSize="10" TextWrapping="Wrap" Style="{StaticResource AttendanceStatusTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- AM Out -->
                    <DataGridTemplateColumn Header="AM Out" Width="115" SortMemberPath="TimeOutAM">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeOutAM, StringFormat=hh:mm tt}" FontSize="13" />
                                    <TextBlock Text="{Binding TimeOutAMLabel}" FontSize="10" TextWrapping="Wrap" Style="{StaticResource AttendanceStatusTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PM In -->
                    <DataGridTemplateColumn Header="PM In" Width="115" SortMemberPath="TimeInPM">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeInPM, StringFormat=hh:mm tt}" FontSize="13" />
                                    <TextBlock Text="{Binding TimeInPMLabel}" FontSize="10" TextWrapping="Wrap" Style="{StaticResource AttendanceStatusTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PM Out -->
                    <DataGridTemplateColumn Header="PM Out" Width="115" SortMemberPath="TimeOutPM">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeOutPM, StringFormat=hh:mm tt}" FontSize="13" />
                                    <TextBlock Text="{Binding TimeOutPMLabel}" FontSize="10" TextWrapping="Wrap" Style="{StaticResource AttendanceStatusTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Hours"      Binding="{Binding TotalHours, StringFormat=N2}"             Width="80" />
                    <DataGridTextColumn Header="Late (min)" Binding="{Binding TardinessMinutes}"                        Width="100" />

                    <!-- Biometric icon column -->
                    <DataGridTemplateColumn Header="Biometric" Width="85" SortMemberPath="IsBiometricVerified">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Width="16" Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="FingerprintOff" />
                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBiometricVerified}" Value="True">
                                                    <Setter Property="Kind" Value="Fingerprint" />
                                                    <Setter Property="Foreground" Value="#0F766E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Punch status icon -->
                    <DataGridTemplateColumn Header="Punch" Width="75" SortMemberPath="HasMissingPunch">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Width="16" Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="CheckCircleOutline" />
                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissingPunch}" Value="True">
                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="LastLoadedText"
                       Text="Not loaded"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}"
                        Background="#0F766E"
                        Click="ExportCsv_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDelimitedOutline" Width="17" Height="17" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Export CSV" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}"
                        Background="#475569"
                        Click="Close_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Close" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
