<Window x:Class="AttendancePayrollSystem.GenerateDtrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Generate DTR — All Employees"
        Height="680"
        Width="780"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                CornerRadius="14"
                Padding="18,16"
                Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#1E3A5F" Offset="0.6" />
                    <GradientStop Color="#0F4C75" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <materialDesign:PackIcon Kind="CalendarAccount"
                                         Width="42" Height="42"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Generate DTR for All Employees"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Select a period, choose employees, then preview or print."
                               Foreground="#B0CCE0"
                               FontSize="13"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Period & Filter Controls -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <DatePicker Grid.Column="1" x:Name="StartDatePicker" VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <DatePicker Grid.Column="4" x:Name="EndDatePicker" VerticalAlignment="Center" />

                <Button Grid.Column="6"
                        Content="Select All"
                        Width="90"
                        Style="{StaticResource ModernButton}"
                        Background="#0F766E"
                        Margin="0,0,6,0"
                        Click="SelectAll_Click" />
                <Button Grid.Column="7"
                        Content="Deselect All"
                        Width="90"
                        Style="{StaticResource ModernButton}"
                        Background="#64748B"
                        Click="DeselectAll_Click" />
            </Grid>
        </Border>

        <!-- Employee List -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="EmployeeCountText"
                                   Text="Loading employees..."
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   x:Name="SelectedCountText"
                                   Foreground="#0F766E"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="EmployeeGrid"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="SelectAllCheckBox" Click="SelectAllCheckBox_Click" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              Click="EmployeeCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Code" Binding="{Binding Employee.EmployeeCode}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Full Name" Binding="{Binding Employee.FullName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Department" Binding="{Binding Employee.Department}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="Position" Binding="{Binding Employee.Position}" Width="160" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Progress Bar (hidden until generating) -->
        <Border Grid.Row="3" Padding="0,0,0,8" Visibility="Collapsed" x:Name="ProgressPanel">
            <StackPanel>
                <TextBlock x:Name="ProgressText" Text="Generating..." Foreground="#1D4ED8" Margin="0,0,0,4" />
                <ProgressBar x:Name="GenerateProgress" Height="6" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="4"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           x:Name="StatusText"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ModernButton}"
                            Background="#7E3AF2"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="PreviewSelected_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileFind" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}"
                            Background="#123C47"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="PrintAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Print All" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}"
                            Background="#7C2D12"
                            Width="140"
                            Margin="0,0,8,0"
                            Click="SaveAllPdf_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save All PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}"
                            Background="#475569"
                            Width="80"
                            Click="Close_Click">
                        <TextBlock Text="Close" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
