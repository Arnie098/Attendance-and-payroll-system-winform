<Window x:Class="AttendancePayrollSystem.DatabaseBackupModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Backup Type"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        MinWidth="400"
        Background="#F8FAFC">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Database Backup Type"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A" />
            <TextBlock Text="Choose how much data to export. Differential and incremental backups require a previous backup manifest in the same folder."
                       Margin="0,8,0,18"
                       TextWrapping="Wrap"
                       Foreground="#475569" />

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Background="White" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="FullBackupRadioButton"
                                 Content="Full Backup"
                                 FontWeight="SemiBold"
                                 IsChecked="True" />
                    <TextBlock Text="Exports the full schema and all rows. Use this first."
                               Margin="24,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#64748B" />
                </StackPanel>
            </Border>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Background="White" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="DifferentialBackupRadioButton"
                                 Content="Differential Backup"
                                 FontWeight="SemiBold" />
                    <TextBlock Text="Exports rows changed since the latest full backup in the same folder."
                               Margin="24,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#64748B" />
                </StackPanel>
            </Border>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Background="White" Padding="14">
                <StackPanel>
                    <RadioButton x:Name="IncrementalBackupRadioButton"
                                 Content="Incremental Backup"
                                 FontWeight="SemiBold" />
                    <TextBlock Text="Exports rows changed since the latest backup of any type in the same folder."
                               Margin="24,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#64748B" />
                </StackPanel>
            </Border>

            <TextBlock Text="Keep the generated `.manifest.json` file next to each SQL backup. The app uses it to calculate future differential and incremental backups."
                       Margin="0,18,0,18"
                       TextWrapping="Wrap"
                       Foreground="#92400E" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button Content="Continue"
                        Width="120"
                        Click="Continue_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
